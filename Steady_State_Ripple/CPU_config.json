{
    "_description": "Steady-State Rail Verification and Ripple Test Configuration",
    "_instructions": "Edit values below instead of modifying the Python code. Re-run the test to pick up changes.",

    "instrument_addresses": {
        "_note": "VISA address strings for each instrument",
        "psu":   "USB0::0x05E6::0x2230::805224014816710016::INSTR",
        "scope": "USB0::0x0957::0x1780::MY65220169::INSTR"
    },

    "output_dir": {
        "_note": "Full path where results should be saved. Use forward slashes.",
        "path": "steady_state_ripple_results"
    },

    "psu_settings": {
        "_note": "PSU channel and voltage for DUT input supply. DUT must already be running — this test does NOT power-cycle.",
        "channel":         1,
        "vin_v":           5.0,
        "current_limit_a": 2.0,
        "ovp_level_v":     6.0
    },

    "scope_settings": {
        "_note": "Shared scope settings applied to all rail measurements. Scope CH1 is used for every rail (one at a time).",
        "probe_attenuation":         1.0,
        "bandwidth_limit_20mhz":     true,
        "timeout_ms":                30000,

        "dc_timebase_s_per_div":     0.01,
        "_dc_note":                  "10 ms/div — wide enough to average switching noise for a clean DC RMS reading",

        "ripple_timebase_s_per_div":  0.000001,
        "ripple_v_scale_v_per_div":  0.05,
        "ripple_coupling":           "AC",
        "ripple_settle_periods":     3,
        "_ripple_note":              "AC coupling, 50 mV/div, 100 ms/div. Script waits (ripple_settle_periods × 10 × timebase) seconds before stopping."
    },

    "rails": [
        {
            "name":            "5V_Input",
            "test_point":      "PSU / TP",
            "nominal_v":       5.0,
            "min_v":           4.75,
            "max_v":           5.25,
            "dc_v_scale":      1.0,
            "ripple_max_mvpp": null,
